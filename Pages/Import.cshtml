@page
@model PayrollDashboard.Pages.ImportModel
@{
    ViewData["Title"] = "Import";
}

<div class="pr-shell">

    @* ── Header ── *@
    <div class="pr-header">
        <div>
            <div class="pr-eyebrow">PAYROLL</div>
            <h1 class="pr-title">PDF を取り込む</h1>
            <div class="pr-subtitle">給与・賞与・源泉徴収票の PDF をインポート</div>
        </div>
    </div>

    @* ── Upload zone ── *@
    <div class="pr-section">
        <div class="pr-section-title" style="margin-bottom:18px;">ファイルアップロード</div>

        <form method="post" enctype="multipart/form-data">
            <div class="pr-upload-zone" id="uploadZone">
                <svg width="40" height="40" viewBox="0 0 40 40" style="display:block; margin:0 auto; opacity:.5;">
                    <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                    <path d="M20 27 L20 13 M13 20 L20 13 L27 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <div style="font-size:14px; font-weight:600; margin-top:16px;">PDF をドラッグ &amp; ドロップ</div>
                <div style="font-size:12px; color:var(--pr-sub); margin-top:5px;">または下のフォームから選択</div>
                <div style="font:500 11px/1 var(--pr-font-mono); color:var(--pr-sub); margin-top:14px; opacity:.7;">PDF · 最大 10MB</div>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:16px;">
                <div>
                    <label class="pr-label" for="uploadFile">PDF ファイル</label>
                    <input class="pr-input" id="uploadFile" type="file" asp-for="UploadFile" accept=".pdf,application/pdf" />
                </div>
                <div>
                    <label class="pr-label" for="payrollMonth">支給月</label>
                    <input class="pr-input" id="payrollMonth" type="text" asp-for="PayrollMonth" placeholder="2026-06" />
                </div>
            </div>

            <button class="pr-btn pr-btn--primary" type="submit" style="margin-top:16px;">アップロード</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="pr-notice pr-notice--info" style="margin-top:14px;">@Model.StatusMessage</div>
        }

        @if (Model.CurrentSlip is not null)
        {
            <div class="pr-notice pr-notice--ok" style="margin-top:14px;">
                <strong>@Model.CurrentSlip.SourceFileName</strong> を取り込みました
                <span style="margin-left:12px; font:500 11px/1 var(--pr-font-mono); opacity:.7;">@Model.CurrentSlip.PayrollMonth</span>
            </div>
        }
    </div>

    @* ── Bulk import ── *@
    <div class="pr-section">
        <div class="pr-section-title" style="margin-bottom:4px;">一括取込</div>
        <div class="pr-section-sub" style="margin-bottom:18px;">datas/ フォルダ内の PDF をまとめて取り込みます</div>

        <div style="display:flex; gap:12px; flex-wrap:wrap;">
            <form method="post" asp-page-handler="ImportAll">
                <button class="pr-btn pr-btn--ghost" type="submit">給与・賞与を一括取込</button>
            </form>
            <form method="post" asp-page-handler="ImportAnnualIncome">
                <button class="pr-btn pr-btn--ghost" type="submit">源泉徴収票を一括取込</button>
            </form>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.BulkMessage))
        {
            <div class="pr-notice pr-notice--ok" style="margin-top:14px;">@Model.BulkMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.AnnualBulkMessage))
        {
            <div class="pr-notice pr-notice--ok" style="margin-top:14px;">@Model.AnnualBulkMessage</div>
        }
    </div>

</div>

@section Scripts {
<style>
.pr-upload-zone {
    border: 1.5px dashed var(--pr-border);
    border-radius: 12px;
    background: var(--pr-faint);
    padding: 40px 24px;
    text-align: center;
    color: var(--pr-text);
    transition: border-color .2s, background .2s;
}
html.dark .pr-upload-zone {
    border-color: rgba(45,212,191,.3);
    background: rgba(45,212,191,.03);
}
.pr-label {
    display: block;
    font: 500 12px/1 var(--pr-font-mono);
    color: var(--pr-sub);
    margin-bottom: 8px;
    letter-spacing: .04em;
}
.pr-input {
    display: block;
    width: 100%;
    padding: 9px 12px;
    font: 14px/1.4 var(--pr-font-sans);
    color: var(--pr-text);
    background: var(--pr-shell);
    border: 1px solid var(--pr-border);
    border-radius: 8px;
    outline: none;
    transition: border-color .2s, background .25s;
}
.pr-input:focus { border-color: var(--pr-accent); }
.pr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 13px/1 var(--pr-font-sans);
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all .2s;
}
.pr-btn--primary {
    background: var(--pr-text);
    color: var(--pr-shell);
}
.pr-btn--primary:hover { opacity: .85; }
html.dark .pr-btn--primary {
    background: var(--pr-accent);
    color: #0b0f1a;
}
.pr-btn--ghost {
    background: transparent;
    color: var(--pr-text);
    border: 1px solid var(--pr-border);
}
.pr-btn--ghost:hover { background: var(--pr-faint); }
.pr-notice {
    padding: 12px 16px;
    border-radius: 9px;
    font-size: 13px;
}
.pr-notice--ok  { background: rgba(15,118,110,.08); border: 1px solid rgba(15,118,110,.2); color: var(--pr-text); }
.pr-notice--info { background: var(--pr-faint); border: 1px solid var(--pr-border); color: var(--pr-text); }
html.dark .pr-notice--ok { background: rgba(45,212,191,.08); border-color: rgba(45,212,191,.25); }
</style>
<script>
(function() {
    const saved = localStorage.getItem('pr-theme');
    if (saved === 'dark') document.documentElement.classList.add('dark');
})();
</script>
}
