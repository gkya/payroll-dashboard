@page "/slip/{id:int}"
@model PayrollDashboard.Pages.SlipDetailModel
@using PayrollDashboard.Models
@{
    ViewData["Title"] = "明細詳細";
    var slip = Model.Slip!;
    var isBonus = slip.SlipType == PayrollSlipType.Bonus;
    var deductRate = (slip.GrossAmount is > 0 && slip.DeductionAmount.HasValue)
        ? slip.DeductionAmount!.Value / slip.GrossAmount!.Value * 100 : (decimal?)null;
    var netRate = (slip.GrossAmount is > 0 && slip.NetAmount.HasValue)
        ? slip.NetAmount!.Value / slip.GrossAmount!.Value * 100 : (decimal?)null;

    var fromTab  = Request.Query["tab"].ToString();
    var fromYear = Request.Query["year"].ToString();
    var backUrl  = string.IsNullOrEmpty(fromTab) ? "/" : $"/?tab={fromTab}&year={fromYear}";
    var tabParam = string.IsNullOrEmpty(fromTab) ? "" : $"?tab={fromTab}&year={fromYear}";
}

<div class="pr-shell">

    @* ── Header ── *@
    <div class="pr-header" style="align-items:center;">
        <div>
            <div class="pr-eyebrow">@slip.PayrollMonth</div>
            <h1 class="pr-title" style="font-size:28px; margin-top:8px;">
                @(isBonus ? "賞与" : "給与")支給明細書
            </h1>
            <div class="pr-subtitle">@slip.PayrollMonth 支給</div>
        </div>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <span class="pr-badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "pr-badge--ok" : "pr-badge--err")"
                  style="font-size:11px; padding:6px 10px;">@slip.ImportStatus</span>

            <div style="display:flex; gap:6px; margin-left:8px;">
                <a href="@backUrl" class="pr-nav-btn">← 戻る</a>

                @if (Model.PrevSlip != null)
                {
                    <a href="/slip/@Model.PrevSlip.Id@tabParam" class="pr-nav-btn">‹ @Model.PrevSlip.PayrollMonth</a>
                }
                else
                {
                    <span class="pr-nav-btn pr-nav-btn--disabled">‹ 前月</span>
                }

                @if (Model.NextSlip != null)
                {
                    <a href="/slip/@Model.NextSlip.Id@tabParam" class="pr-nav-btn">@Model.NextSlip.PayrollMonth ›</a>
                }
                else
                {
                    <span class="pr-nav-btn pr-nav-btn--disabled">次月 ›</span>
                }
            </div>
        </div>
    </div>

    @* ── 3-column KPI strip ── *@
    <div class="pr-kpi" style="grid-template-columns: repeat(3,1fr);">
        <div class="pr-kpi-cell">
            <div class="pr-kpi-label">総支給額</div>
            <div class="pr-kpi-value">@(slip.GrossAmount.HasValue ? "¥" + slip.GrossAmount.Value.ToString("N0") : "—")</div>
        </div>
        <div class="pr-kpi-cell">
            <div class="pr-kpi-label">控除合計</div>
            <div class="pr-kpi-value" style="color:#e11d48;">
                @(slip.DeductionAmount.HasValue ? "−¥" + slip.DeductionAmount.Value.ToString("N0") : "—")
            </div>
            <div class="pr-kpi-meta">控除率 @(deductRate?.ToString("F1") + "%" ?? "—")</div>
        </div>
        <div class="pr-kpi-cell" style="border-right:none;">
            <div class="pr-kpi-label">手取り額</div>
            <div class="pr-kpi-value" style="color:var(--pr-net-color);">
                @(slip.NetAmount.HasValue ? "¥" + slip.NetAmount.Value.ToString("N0") : "—")
            </div>
            <div class="pr-kpi-meta">手取り率 @(netRate?.ToString("F1") + "%" ?? "—")</div>
        </div>
    </div>

    @* ── 支給 / 取込情報 ── *@
    <div style="display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid var(--pr-border);">

        <div class="pr-section" style="border-bottom:none; border-right:1px solid var(--pr-border);">
            <div style="font:600 11px/1 var(--pr-font-mono); letter-spacing:.1em; color:var(--pr-sub); margin-bottom:14px;">支給</div>
            <div class="pr-dl-row">
                <span>支給月</span>
                <span>@slip.PayrollMonth</span>
            </div>
            <div class="pr-dl-row">
                <span>基本給</span>
                <span>@(slip.BasicAmount?.ToString("N0") ?? "—") 円</span>
            </div>
            @if (!isBonus)
            {
                <div class="pr-dl-row">
                    <span>残業時間</span>
                    <span>@(slip.OvertimeHours?.ToString("F2") ?? "—") 時間</span>
                </div>
            }
        </div>

        <div class="pr-section" style="border-bottom:none;">
            <div style="font:600 11px/1 var(--pr-font-mono); letter-spacing:.1em; color:var(--pr-sub); margin-bottom:14px;">ソースファイル</div>
            <div class="pr-dl-row">
                <span>ファイル名</span>
                <span style="font-family:var(--pr-font-mono); font-size:12px; word-break:break-all;">@slip.SourceFileName</span>
            </div>
            <div class="pr-dl-row">
                <span>取込日時</span>
                <span style="font-family:var(--pr-font-mono); font-size:12px;">@slip.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            @if (!string.IsNullOrEmpty(slip.ParseMessage))
            {
                <div class="pr-dl-row">
                    <span>メッセージ</span>
                    <span style="color:#e11d48;">@slip.ParseMessage</span>
                </div>
            }
        </div>

    </div>

    @* ── 原本 PDF ── *@
    <div class="pr-section" style="border-bottom:none;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div class="pr-section-title">原本 PDF</div>
            <a href="/api/payroll/slips/@slip.Id/pdf" target="_blank" class="pr-nav-btn">別タブで開く ↗</a>
        </div>
        <div style="border:1px solid var(--pr-border); border-radius:8px; overflow:hidden;">
            <object data="/api/payroll/slips/@slip.Id/pdf"
                    type="application/pdf"
                    width="100%" height="900"
                    style="display:block;">
                <embed src="/api/payroll/slips/@slip.Id/pdf"
                       type="application/pdf"
                       width="100%" height="900"
                       style="display:block;" />
            </object>
        </div>
    </div>

</div>

@section Scripts {
<style>
.pr-nav-btn {
    font: 500 12px/1 var(--pr-font-sans);
    padding: 7px 13px;
    border-radius: 7px;
    border: 1px solid var(--pr-border);
    color: var(--pr-text);
    text-decoration: none;
    background: transparent;
    white-space: nowrap;
    transition: background .15s, color .15s;
    cursor: pointer;
}
.pr-nav-btn:hover { background: var(--pr-faint); color: var(--pr-text); }
.pr-nav-btn--disabled {
    opacity: .35;
    cursor: not-allowed;
    pointer-events: none;
}
.pr-dl-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 9px 0;
    font-size: 13px;
    border-top: 1px solid var(--pr-row-border);
}
.pr-dl-row span:first-child { color: var(--pr-sub); flex-shrink: 0; }
.pr-dl-row span:last-child  { color: var(--pr-row-strong); text-align: right; }
</style>
<script>
(function() {
    const saved = localStorage.getItem('pr-theme');
    if (saved === 'dark') document.documentElement.classList.add('dark');
})();
</script>
}
