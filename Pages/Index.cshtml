@page
@model IndexModel
@using PayrollDashboard.Models
@using System.Linq
@{
    ViewData["Title"] = "Payroll Dashboard";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Payroll Dashboard</h1>
        <p class="lead">給与明細 PDF を取り込み、一覧・集計・可視化する学習用アプリです。</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Upload</h2>
                    <p class="card-text">給与明細 PDF をアップロードして、アプリに取り込みます。</p>
                    <a href="/Import" class="btn btn-sm btn-primary">Go to Import</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">給与</h2>
                    <p class="card-text">取り込んだ給与明細を確認します。</p>
                    <span class="badge bg-secondary">@Model.SalarySlips.Count 件</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">賞与</h2>
                    <p class="card-text">取り込んだ賞与明細を確認します。</p>
                    <span class="badge bg-secondary">@Model.BonusSlips.Count 件</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.SalarySlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
    {
        var latestSalary = Model.SalarySlips.LastOrDefault();
        var latestAnnual = Model.AnnualIncomeSlips.LastOrDefault();

        <div class="row g-3 mb-5">
            <div class="col-sm-6 col-xl-3">
                <div class="card shadow-sm h-100 border-start border-success border-4">
                    <div class="card-body">
                        <div class="text-muted small mb-1">直近の手取り額</div>
                        <div class="fs-4 fw-bold">
                            @(latestSalary?.NetAmount.HasValue == true
                                ? "¥" + latestSalary.NetAmount.Value.ToString("N0")
                                : "—")
                        </div>
                        <div class="text-muted small mt-1">@(latestSalary?.PayrollMonth ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card shadow-sm h-100 border-start border-primary border-4">
                    <div class="card-body">
                        <div class="text-muted small mb-1">直近の総支給額</div>
                        <div class="fs-4 fw-bold">
                            @(latestSalary?.GrossAmount.HasValue == true
                                ? "¥" + latestSalary.GrossAmount.Value.ToString("N0")
                                : "—")
                        </div>
                        <div class="text-muted small mt-1">@(latestSalary?.PayrollMonth ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card shadow-sm h-100 border-start border-secondary border-4">
                    <div class="card-body">
                        <div class="text-muted small mb-1">直近の残業時間</div>
                        <div class="fs-4 fw-bold">
                            @(latestSalary?.OvertimeHours.HasValue == true
                                ? latestSalary.OvertimeHours.Value.ToString("F2") + " h"
                                : "—")
                        </div>
                        <div class="text-muted small mt-1">@(latestSalary?.PayrollMonth ?? "—")</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card shadow-sm h-100 border-start border-warning border-4">
                    <div class="card-body">
                        <div class="text-muted small mb-1">最新の年収（源泉徴収票）</div>
                        <div class="fs-4 fw-bold">
                            @(latestAnnual?.TotalIncome.HasValue == true
                                ? "¥" + latestAnnual.TotalIncome.Value.ToString("N0")
                                : "—")
                        </div>
                        <div class="text-muted small mt-1">@(latestAnnual != null ? latestAnnual.FiscalYear + " 年" : "—")</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.PayrollSlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
    {
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#salary-tab">給与</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#bonus-tab">賞与</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#annual-tab">源泉徴収票</button>
            </li>
        </ul>

        <div class="tab-content">

            @* ── 給与タブ ── *@
            <div class="tab-pane fade show active" id="salary-tab">
                @if (Model.SalarySlips.Count > 0)
                {
                    var salaryYears = Model.SalarySlips
                        .Select(s => s.PayrollMonth[..4])
                        .Distinct().OrderBy(y => y).ToList();

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h2 class="h5 mb-0">給与推移</h2>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary active"   onclick="toggle(salaryChart, 0, this)">総支給額</button>
                                    <button class="btn btn-outline-warning active"   onclick="toggle(salaryChart, 1, this)">基本給</button>
                                    <button class="btn btn-outline-danger active"    onclick="toggle(salaryChart, 2, this)">控除合計</button>
                                    <button class="btn btn-outline-success active"   onclick="toggle(salaryChart, 3, this)">手取り額</button>
                                    <button class="btn btn-outline-secondary active" onclick="toggle(salaryChart, 4, this)">残業時間</button>
                                </div>
                            </div>
                            <div class="mt-2">
                                <span class="me-2 small text-muted">年度：</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-dark active salary-year-btn" data-year="all" onclick="filterSalary('all')">全て</button>
                                    @foreach (var year in salaryYears)
                                    {
                                        <button class="btn btn-outline-dark salary-year-btn" data-year="@year" onclick="filterSalary('@year')">@year 年</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="salaryChart" height="80"></canvas>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="table-responsive">
                            <table id="salary-table" class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>支給月</th>
                                        <th class="text-end">総支給額</th>
                                        <th class="text-end">基本給</th>
                                        <th class="text-end">残業時間</th>
                                        <th class="text-end">控除合計</th>
                                        <th class="text-end">手取り額</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.SalarySlips)
                                    {
                                        <tr data-year="@slip.PayrollMonth[..4]">
                                            <td>@slip.PayrollMonth</td>
                                            <td class="text-end">@(slip.GrossAmount?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.BasicAmount?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.OvertimeHours?.ToString("F2") ?? "-")</td>
                                            <td class="text-end">@(slip.DeductionAmount?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.NetAmount?.ToString("N0") ?? "-")</td>
                                            <td><span class="badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "bg-success" : "bg-warning")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-semibold">
                                    <tr>
                                        <td id="salary-avg-label"></td>
                                        <td class="text-end" id="salary-avg-gross"></td>
                                        <td class="text-end" id="salary-avg-basic"></td>
                                        <td class="text-end" id="salary-avg-overtime"></td>
                                        <td class="text-end" id="salary-avg-deduct"></td>
                                        <td class="text-end" id="salary-avg-net"></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">給与データがありません。</p>
                }
            </div>

            @* ── 賞与タブ ── *@
            <div class="tab-pane fade" id="bonus-tab">
                @if (Model.BonusSlips.Count > 0)
                {
                    var bonusYears = Model.BonusSlips
                        .Select(s => s.PayrollMonth[..4])
                        .Distinct().OrderBy(y => y).ToList();

                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h2 class="h5 mb-0">賞与推移</h2>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary active" onclick="toggle(bonusChart, 0, this)">総支給額</button>
                                    <button class="btn btn-outline-danger active"  onclick="toggle(bonusChart, 1, this)">控除合計</button>
                                    <button class="btn btn-outline-success active" onclick="toggle(bonusChart, 2, this)">手取り額</button>
                                </div>
                            </div>
                            <div class="mt-2">
                                <span class="me-2 small text-muted">年度：</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-dark active bonus-year-btn" data-year="all" onclick="filterBonus('all')">全て</button>
                                    @foreach (var year in bonusYears)
                                    {
                                        <button class="btn btn-outline-dark bonus-year-btn" data-year="@year" onclick="filterBonus('@year')">@year 年</button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="bonusChart" height="80"></canvas>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="table-responsive">
                            <table id="bonus-table" class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>支給月</th>
                                        <th class="text-end">総支給額</th>
                                        <th class="text-end">控除合計</th>
                                        <th class="text-end">手取り額</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.BonusSlips)
                                    {
                                        <tr data-year="@slip.PayrollMonth[..4]">
                                            <td>@slip.PayrollMonth</td>
                                            <td class="text-end">@(slip.GrossAmount?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.DeductionAmount?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.NetAmount?.ToString("N0") ?? "-")</td>
                                            <td><span class="badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "bg-success" : "bg-warning")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">賞与データがありません。</p>
                }
            </div>

            @* ── 源泉徴収票タブ ── *@
            <div class="tab-pane fade" id="annual-tab">
                @if (Model.AnnualIncomeSlips.Count > 0)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h2 class="h5 mb-0">年収推移</h2>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary active"  onclick="toggle(annualChart, 0, this)">支払金額</button>
                                <button class="btn btn-outline-warning active"  onclick="toggle(annualChart, 1, this)">給与所得控除後</button>
                                <button class="btn btn-outline-danger active"   onclick="toggle(annualChart, 2, this)">所得控除合計</button>
                                <button class="btn btn-outline-success active"  onclick="toggle(annualChart, 3, this)">源泉徴収税額</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="annualChart" height="80"></canvas>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>年度</th>
                                        <th class="text-end">支払金額</th>
                                        <th class="text-end">給与所得控除後の金額</th>
                                        <th class="text-end">所得控除の額の合計額</th>
                                        <th class="text-end">源泉徴収税額</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.AnnualIncomeSlips)
                                    {
                                        <tr>
                                            <td>@slip.FiscalYear 年</td>
                                            <td class="text-end">@(slip.TotalIncome?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.AfterDeduction?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.TotalDeductions?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(slip.WithholdingTax?.ToString("N0") ?? "-")</td>
                                            <td><span class="badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "bg-success" : "bg-warning")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">源泉徴収票データがありません。</p>
                }
            </div>

        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p class="mb-0">まだデータがありません。<a href="/Import">Import ページ</a>から PDF をアップロードしてください。</p>
        </div>
    }
</div>

@if (Model.PayrollSlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
{
    string AnnualLabels() =>
        string.Join(",", Model.AnnualIncomeSlips.Select(s => $"\"{s.FiscalYear}年\""));
    string AnnualData(Func<AnnualIncomeSlip, decimal?> sel) =>
        string.Join(",", Model.AnnualIncomeSlips.Select(s => sel(s) is { } v ? v.ToString() : "null"));

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 給与専用：右軸に残業時間を追加
        function makeSalaryChart(id, labels, gross, basic, deduct, net, overtime) {
            return new Chart(document.getElementById(id), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: '総支給額', data: gross,    yAxisID: 'y',  borderColor: 'rgb(13,110,253)',  tension: 0.3, fill: false },
                        { label: '基本給',   data: basic,    yAxisID: 'y',  borderColor: 'rgb(255,193,7)',   tension: 0.3, fill: false },
                        { label: '控除合計', data: deduct,   yAxisID: 'y',  borderColor: 'rgb(220,53,69)',   tension: 0.3, fill: false },
                        { label: '手取り額', data: net,      yAxisID: 'y',  borderColor: 'rgb(25,135,84)',   tension: 0.3, fill: false },
                        { label: '残業時間', data: overtime, yAxisID: 'y2', borderColor: 'rgb(108,117,125)', tension: 0.3, fill: false, borderDash: [5, 5] },
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y:  { position: 'left',  ticks: { callback: v => v.toLocaleString() + ' 円' } },
                        y2: { position: 'right', ticks: { callback: v => v + ' h' }, grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        // 賞与・源泉徴収票用（右軸なし）
        function makeChart(id, labels, gross, basic, deduct, net) {
            return new Chart(document.getElementById(id), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label: '総支給額', data: gross, borderColor: 'rgb(13,110,253)',  tension: 0.3, fill: false },
                        { label: '基本給',   data: basic, borderColor: 'rgb(255,193,7)',   tension: 0.3, fill: false },
                        { label: '控除合計', data: deduct, borderColor: 'rgb(220,53,69)',  tension: 0.3, fill: false },
                        { label: '手取り額', data: net,    borderColor: 'rgb(25,135,84)',  tension: 0.3, fill: false },
                    ]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { ticks: { callback: v => v.toLocaleString() + ' 円' } } }
                }
            });
        }

        function toggle(chart, index, btn) {
            const meta = chart.getDatasetMeta(index);
            meta.hidden = !meta.hidden;
            btn.classList.toggle('active');
            chart.update();
        }

        @if (Model.SalarySlips.Count > 0)
        {
            var salaryJson = System.Text.Json.JsonSerializer.Serialize(Model.SalarySlips.Select(s => new {
                month = s.PayrollMonth,
                year  = s.PayrollMonth[..4],
                gross    = s.GrossAmount,
                basic    = s.BasicAmount,
                deduct   = s.DeductionAmount,
                net      = s.NetAmount,
                overtime = s.OvertimeHours,
            }));
            <text>
        const allSalarySlips = @Html.Raw(salaryJson);

        const salaryChart = makeSalaryChart('salaryChart',
            allSalarySlips.map(s => s.month),
            allSalarySlips.map(s => s.gross),
            allSalarySlips.map(s => s.basic),
            allSalarySlips.map(s => s.deduct),
            allSalarySlips.map(s => s.net),
            allSalarySlips.map(s => s.overtime)
        );

        function updateSalaryAverage(slips) {
            const avg = key => {
                const vals = slips.map(s => s[key]).filter(v => v != null);
                return vals.length > 0 ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
            };
            const fmtInt  = v => v != null ? Math.round(v).toLocaleString('ja-JP') : '-';
            const fmtDec  = v => v != null ? v.toFixed(2) : '-';
            document.getElementById('salary-avg-label').textContent   = `平均（${slips.length} 件）`;
            document.getElementById('salary-avg-gross').textContent   = fmtInt(avg('gross'));
            document.getElementById('salary-avg-basic').textContent   = fmtInt(avg('basic'));
            document.getElementById('salary-avg-overtime').textContent = fmtDec(avg('overtime'));
            document.getElementById('salary-avg-deduct').textContent  = fmtInt(avg('deduct'));
            document.getElementById('salary-avg-net').textContent     = fmtInt(avg('net'));
        }

        function filterSalary(year) {
            const f = year === 'all' ? allSalarySlips : allSalarySlips.filter(s => s.year === year);
            salaryChart.data.labels = f.map(s => s.month);
            const keys = ['gross', 'basic', 'deduct', 'net', 'overtime'];
            keys.forEach((k, i) => salaryChart.data.datasets[i].data = f.map(s => s[k]));
            salaryChart.update();
            document.querySelectorAll('#salary-table tr[data-year]').forEach(row => {
                row.style.display = (year === 'all' || row.dataset.year === year) ? '' : 'none';
            });
            document.querySelectorAll('.salary-year-btn').forEach(btn =>
                btn.classList.toggle('active', btn.dataset.year === year));
            updateSalaryAverage(f);
        }

        updateSalaryAverage(allSalarySlips);
            </text>
        }
        @if (Model.BonusSlips.Count > 0)
        {
            var bonusJson = System.Text.Json.JsonSerializer.Serialize(Model.BonusSlips.Select(s => new {
                month  = s.PayrollMonth,
                year   = s.PayrollMonth[..4],
                gross  = s.GrossAmount,
                deduct = s.DeductionAmount,
                net    = s.NetAmount,
            }));
            <text>
        const allBonusSlips = @Html.Raw(bonusJson);

        const bonusChart = makeChart('bonusChart',
            allBonusSlips.map(s => s.month),
            allBonusSlips.map(s => s.gross),
            [],
            allBonusSlips.map(s => s.deduct),
            allBonusSlips.map(s => s.net)
        );

        function filterBonus(year) {
            const f = year === 'all' ? allBonusSlips : allBonusSlips.filter(s => s.year === year);
            bonusChart.data.labels = f.map(s => s.month);
            bonusChart.data.datasets[0].data = f.map(s => s.gross);
            bonusChart.data.datasets[2].data = f.map(s => s.deduct);
            bonusChart.data.datasets[3].data = f.map(s => s.net);
            bonusChart.update();
            document.querySelectorAll('#bonus-table tr[data-year]').forEach(row => {
                row.style.display = (year === 'all' || row.dataset.year === year) ? '' : 'none';
            });
            document.querySelectorAll('.bonus-year-btn').forEach(btn =>
                btn.classList.toggle('active', btn.dataset.year === year));
        }
            </text>
        }
        @if (Model.AnnualIncomeSlips.Count > 0)
        {
            <text>
        const annualChart = makeChart('annualChart',
            [@Html.Raw(AnnualLabels())],
            [@Html.Raw(AnnualData(s => s.TotalIncome))],
            [@Html.Raw(AnnualData(s => s.AfterDeduction))],
            [@Html.Raw(AnnualData(s => s.TotalDeductions))],
            [@Html.Raw(AnnualData(s => s.WithholdingTax))]
        );
            </text>
        }
    </script>
}
