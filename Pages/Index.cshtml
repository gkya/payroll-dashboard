@page
@model IndexModel
@{
    ViewData["Title"] = "Payroll Dashboard";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Payroll Dashboard</h1>
        <p class="lead">給与明細 PDF を取り込み、一覧・集計・可視化する学習用アプリです。</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Upload</h2>
                    <p class="card-text">給与明細 PDF をアップロードして、アプリに取り込みます。</p>
                    <a href="/Import" class="btn btn-sm btn-primary">Go to Import</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">List</h2>
                    <p class="card-text">取り込んだ給与明細を一覧で確認します。</p>
                    <span class="badge bg-secondary">@Model.PayrollSlips.Count 件</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Dashboard</h2>
                    <p class="card-text">支給額、控除額、手取り額の推移を見える化します。</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PayrollSlips.Count > 0)
    {
        var ordered = Model.PayrollSlips.OrderBy(s => s.PayrollMonth).ToList();
        var labels    = string.Join(",", ordered.Select(s => $"\"{s.PayrollMonth}\""));
        var grossData = string.Join(",", ordered.Select(s => s.GrossAmount.HasValue     ? s.GrossAmount.Value.ToString()     : "null"));
        var deductData= string.Join(",", ordered.Select(s => s.DeductionAmount.HasValue ? s.DeductionAmount.Value.ToString() : "null"));
        var netData   = string.Join(",", ordered.Select(s => s.NetAmount.HasValue       ? s.NetAmount.Value.ToString()       : "null"));

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">推移グラフ</h2>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary active" onclick="toggleDataset(0, this)">総支給額</button>
                    <button type="button" class="btn btn-outline-danger active"  onclick="toggleDataset(1, this)">控除合計</button>
                    <button type="button" class="btn btn-outline-success active" onclick="toggleDataset(2, this)">手取り額</button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="payrollChart" height="80"></canvas>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h2 class="h5 mb-0">Imported Payroll Slips</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Payroll Month</th>
                            <th class="text-end">総支給額</th>
                            <th class="text-end">控除合計</th>
                            <th class="text-end">手取り額</th>
                            <th>Status</th>
                            <th>Imported At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slip in Model.PayrollSlips)
                        {
                            <tr>
                                <td>@slip.PayrollMonth</td>
                                <td class="text-end">@(slip.GrossAmount.HasValue ? slip.GrossAmount.Value.ToString("N0") : "-")</td>
                                <td class="text-end">@(slip.DeductionAmount.HasValue ? slip.DeductionAmount.Value.ToString("N0") : "-")</td>
                                <td class="text-end">@(slip.NetAmount.HasValue ? slip.NetAmount.Value.ToString("N0") : "-")</td>
                                <td>
                                    <span class="badge @(slip.ImportStatus == PayrollDashboard.Models.PayrollImportStatus.Parsed ? "bg-success" : "bg-warning")">@slip.ImportStatus</span>
                                </td>
                                <td>@slip.ImportedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <p class="mb-0">まだデータがありません。<a href="/Import">Import ページ</a>から PDF をアップロードしてください。</p>
        </div>
    }
</div>

@if (Model.PayrollSlips.Count > 0)
{
    var ordered    = Model.PayrollSlips.OrderBy(s => s.PayrollMonth).ToList();
    var labels     = string.Join(",", ordered.Select(s => $"\"{s.PayrollMonth}\""));
    var grossData  = string.Join(",", ordered.Select(s => s.GrossAmount.HasValue     ? s.GrossAmount.Value.ToString()     : "null"));
    var deductData = string.Join(",", ordered.Select(s => s.DeductionAmount.HasValue ? s.DeductionAmount.Value.ToString() : "null"));
    var netData    = string.Join(",", ordered.Select(s => s.NetAmount.HasValue       ? s.NetAmount.Value.ToString()       : "null"));

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chart = new Chart(document.getElementById('payrollChart'), {
            type: 'line',
            data: {
                labels: [@Html.Raw(labels)],
                datasets: [
                    {
                        label: '総支給額',
                        data: [@Html.Raw(grossData)],
                        borderColor: 'rgb(13, 110, 253)',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        tension: 0.3,
                        fill: false,
                    },
                    {
                        label: '控除合計',
                        data: [@Html.Raw(deductData)],
                        borderColor: 'rgb(220, 53, 69)',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        tension: 0.3,
                        fill: false,
                    },
                    {
                        label: '手取り額',
                        data: [@Html.Raw(netData)],
                        borderColor: 'rgb(25, 135, 84)',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        tension: 0.3,
                        fill: false,
                    },
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                },
                scales: {
                    y: {
                        ticks: {
                            callback: value => value.toLocaleString() + ' 円'
                        }
                    }
                }
            }
        });

        function toggleDataset(index, btn) {
            const meta = chart.getDatasetMeta(index);
            meta.hidden = !meta.hidden;
            btn.classList.toggle('active');
            chart.update();
        }
    </script>
}