@page
@model IndexModel
@using PayrollDashboard.Models
@using System.Linq
@{
    ViewData["Title"] = "Payroll Dashboard";
    var latestSalary = Model.SalarySlips.LastOrDefault();
    var latestAnnual = Model.AnnualIncomeSlips.LastOrDefault();
    var avgOt = Model.SalarySlips.Where(s => s.OvertimeHours.HasValue)
                    .Select(s => (double)s.OvertimeHours!.Value).DefaultIfEmpty(0).Average();
    var dateRange = Model.SalarySlips.Count > 0
        ? $"{Model.SalarySlips.First().PayrollMonth} — {Model.SalarySlips.Last().PayrollMonth} ・ 全 {Model.SalarySlips.Count} ヶ月分"
        : "データなし";
}

<div class="pr-shell">

    @* ── Header ── *@
    <div class="pr-header">
        <div>
            <div class="pr-eyebrow">PAYROLL</div>
            <h1 class="pr-title">給与ダッシュボード</h1>
            <div class="pr-subtitle">@dateRange</div>
        </div>
        <div class="pr-header-right">
            @if (Model.PayrollSlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
            {
                <div class="pr-tabs" id="mainTabs">
                    <button class="pr-tab active" onclick="switchTab('salary-tab',this)">給与</button>
                    <button class="pr-tab" onclick="switchTab('bonus-tab',this)">賞与</button>
                    <button class="pr-tab" onclick="switchTab('annual-tab',this)">源泉徴収票</button>
                </div>
            }
            <div class="pr-theme-toggle" id="themeToggle" onclick="toggleTheme()" role="button" aria-label="テーマ切替">
                <span class="pr-seg pr-seg--on" id="seg-light">☀ Light</span>
                <span class="pr-seg" id="seg-dark">☾ Dark</span>
            </div>
        </div>
    </div>

    @* ── KPI row ── *@
    @if (Model.SalarySlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
    {
        <div class="pr-kpi">
            <div class="pr-kpi-cell">
                <div class="pr-kpi-label">直近の手取り額</div>
                <div class="pr-kpi-value">
                    @(latestSalary?.NetAmount.HasValue == true
                        ? "¥" + latestSalary.NetAmount.Value.ToString("N0")
                        : "—")
                </div>
                <div class="pr-kpi-meta">@(latestSalary?.PayrollMonth ?? "—")</div>
            </div>
            <div class="pr-kpi-cell">
                <div class="pr-kpi-label">直近の総支給額</div>
                <div class="pr-kpi-value">
                    @(latestSalary?.GrossAmount.HasValue == true
                        ? "¥" + latestSalary.GrossAmount.Value.ToString("N0")
                        : "—")
                </div>
                <div class="pr-kpi-meta">@(latestSalary?.PayrollMonth ?? "—")</div>
            </div>
            <div class="pr-kpi-cell">
                <div class="pr-kpi-label">直近の残業時間</div>
                <div class="pr-kpi-value">
                    @(latestSalary?.OvertimeHours.HasValue == true
                        ? latestSalary.OvertimeHours.Value.ToString("F2")
                        : "—")<span style="font-size:15px; color:var(--pr-sub); font-weight:500;"> h</span>
                </div>
                <div class="pr-kpi-meta">月平均 @(avgOt > 0 ? avgOt.ToString("F1") + " h" : "—")</div>
            </div>
            <div class="pr-kpi-cell">
                <div class="pr-kpi-label">最新の年収（源泉徴収票）</div>
                <div class="pr-kpi-value">
                    @(latestAnnual?.TotalIncome.HasValue == true
                        ? "¥" + latestAnnual.TotalIncome.Value.ToString("N0")
                        : "—")
                </div>
                <div class="pr-kpi-meta">@(latestAnnual != null ? latestAnnual.FiscalYear + " 年" : "—")</div>
            </div>
        </div>
    }

    @* ── Tab content ── *@
    @if (Model.PayrollSlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
    {
        <div class="tab-content">

            @* 給与タブ *@
            <div class="tab-pane fade show active" id="salary-tab">
                @if (Model.SalarySlips.Count > 0)
                {
                    var salaryYears = Model.SalarySlips
                        .Select(s => s.PayrollMonth[..4])
                        .Distinct().OrderBy(y => y).ToList();

                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div>
                                <div class="pr-section-title">給与推移</div>
                                <div class="pr-section-sub">総支給額・手取り額の月次推移</div>
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px;">
                                <div class="pr-pill-group">
                                    <button class="pr-pill active" onclick="toggle(salaryChart,0,this)">総支給額</button>
                                    <button class="pr-pill active" onclick="toggle(salaryChart,1,this)">基本給</button>
                                    <button class="pr-pill active" onclick="toggle(salaryChart,2,this)">控除合計</button>
                                    <button class="pr-pill active" onclick="toggle(salaryChart,3,this)">手取り額</button>
                                    <button class="pr-pill active" onclick="toggle(salaryChart,4,this)">残業時間</button>
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="font:500 11px/1 var(--pr-font-mono); color:var(--pr-sub);">年度：</span>
                                    <div class="pr-pill-group">
                                        <button class="pr-pill active salary-year-btn" data-year="all" onclick="filterSalary('all')">全て</button>
                                        @foreach (var year in salaryYears)
                                        {
                                            <button class="pr-pill salary-year-btn" data-year="@year" onclick="filterSalary('@year')">@year</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <canvas id="salaryChart"></canvas>
                    </div>

                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div class="pr-section-title">給与明細</div>
                        </div>
                        <div class="table-responsive">
                            <table id="salary-table" class="pr-table">
                                <thead>
                                    <tr>
                                        <th style="text-align:left;">支給月</th>
                                        <th>総支給額</th>
                                        <th>基本給</th>
                                        <th>残業</th>
                                        <th>控除合計</th>
                                        <th>控除率</th>
                                        <th>手取り額</th>
                                        <th>手取り率</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.SalarySlips)
                                    {
                                        var deductRate = (slip.GrossAmount is > 0 && slip.DeductionAmount.HasValue)
                                            ? slip.DeductionAmount!.Value / slip.GrossAmount!.Value * 100 : (decimal?)null;
                                        var netRate = (slip.GrossAmount is > 0 && slip.NetAmount.HasValue)
                                            ? slip.NetAmount!.Value / slip.GrossAmount!.Value * 100 : (decimal?)null;
                                        <tr data-year="@slip.PayrollMonth[..4]" onclick="goToSlip(@slip.Id,'salary')">
                                            <td>@slip.PayrollMonth</td>
                                            <td>@(slip.GrossAmount?.ToString("N0") ?? "-")</td>
                                            <td>@(slip.BasicAmount?.ToString("N0") ?? "-")</td>
                                            <td style="color:var(--pr-sub);">@(slip.OvertimeHours?.ToString("F2") ?? "-")</td>
                                            <td>@(slip.DeductionAmount?.ToString("N0") ?? "-")</td>
                                            <td style="color:var(--pr-sub);">@(deductRate?.ToString("F1") + "%" ?? "-")</td>
                                            <td class="td-net">@(slip.NetAmount?.ToString("N0") ?? "-")</td>
                                            <td style="color:var(--pr-sub);">@(netRate?.ToString("F1") + "%" ?? "-")</td>
                                            <td><span class="pr-badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "pr-badge--ok" : "pr-badge--err")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td id="salary-avg-label"></td>
                                        <td id="salary-avg-gross"></td>
                                        <td id="salary-avg-basic"></td>
                                        <td id="salary-avg-overtime" style="color:var(--pr-sub);"></td>
                                        <td id="salary-avg-deduct"></td>
                                        <td id="salary-avg-deduct-rate" style="color:var(--pr-sub);"></td>
                                        <td id="salary-avg-net" class="td-net"></td>
                                        <td id="salary-avg-net-rate" style="color:var(--pr-sub);"></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pr-empty">給与データがありません。</div>
                }
            </div>

            @* 賞与タブ *@
            <div class="tab-pane fade" id="bonus-tab">
                @if (Model.BonusSlips.Count > 0)
                {
                    var bonusYears = Model.BonusSlips
                        .Select(s => s.PayrollMonth[..4])
                        .Distinct().OrderBy(y => y).ToList();

                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div>
                                <div class="pr-section-title">賞与推移</div>
                                <div class="pr-section-sub">支給回ごとの推移</div>
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:8px;">
                                <div class="pr-pill-group">
                                    <button class="pr-pill active" onclick="toggle(bonusChart,0,this)">総支給額</button>
                                    <button class="pr-pill active" onclick="toggle(bonusChart,1,this)">控除合計</button>
                                    <button class="pr-pill active" onclick="toggle(bonusChart,2,this)">手取り額</button>
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <span style="font:500 11px/1 var(--pr-font-mono); color:var(--pr-sub);">年度：</span>
                                    <div class="pr-pill-group">
                                        <button class="pr-pill active bonus-year-btn" data-year="all" onclick="filterBonus('all')">全て</button>
                                        @foreach (var year in bonusYears)
                                        {
                                            <button class="pr-pill bonus-year-btn" data-year="@year" onclick="filterBonus('@year')">@year</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <canvas id="bonusChart"></canvas>
                    </div>

                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div class="pr-section-title">賞与明細</div>
                        </div>
                        <div class="table-responsive">
                            <table id="bonus-table" class="pr-table">
                                <thead>
                                    <tr>
                                        <th style="text-align:left;">支給月</th>
                                        <th>総支給額</th>
                                        <th>控除合計</th>
                                        <th>手取り額</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.BonusSlips)
                                    {
                                        <tr data-year="@slip.PayrollMonth[..4]" onclick="goToSlip(@slip.Id,'bonus')">
                                            <td>@slip.PayrollMonth</td>
                                            <td>@(slip.GrossAmount?.ToString("N0") ?? "-")</td>
                                            <td>@(slip.DeductionAmount?.ToString("N0") ?? "-")</td>
                                            <td class="td-net">@(slip.NetAmount?.ToString("N0") ?? "-")</td>
                                            <td><span class="pr-badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "pr-badge--ok" : "pr-badge--err")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pr-empty">賞与データがありません。</div>
                }
            </div>

            @* 源泉徴収票タブ *@
            <div class="tab-pane fade" id="annual-tab">
                @if (Model.AnnualIncomeSlips.Count > 0)
                {
                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div>
                                <div class="pr-section-title">年収推移</div>
                                <div class="pr-section-sub">源泉徴収票ベース</div>
                            </div>
                            <div class="pr-pill-group">
                                <button class="pr-pill active" onclick="toggle(annualChart,0,this)">支払金額</button>
                                <button class="pr-pill active" onclick="toggle(annualChart,1,this)">給与所得控除後</button>
                                <button class="pr-pill active" onclick="toggle(annualChart,2,this)">所得控除合計</button>
                                <button class="pr-pill active" onclick="toggle(annualChart,3,this)">源泉徴収税額</button>
                            </div>
                        </div>
                        <canvas id="annualChart"></canvas>
                    </div>

                    <div class="pr-section">
                        <div class="pr-section-head">
                            <div class="pr-section-title">源泉徴収票一覧</div>
                        </div>
                        <div class="table-responsive">
                            <table class="pr-table">
                                <thead>
                                    <tr>
                                        <th style="text-align:left;">年度</th>
                                        <th>支払金額</th>
                                        <th>給与所得控除後の金額</th>
                                        <th>所得控除の額の合計額</th>
                                        <th>源泉徴収税額</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var slip in Model.AnnualIncomeSlips)
                                    {
                                        <tr>
                                            <td>@slip.FiscalYear 年</td>
                                            <td>@(slip.TotalIncome?.ToString("N0") ?? "-")</td>
                                            <td>@(slip.AfterDeduction?.ToString("N0") ?? "-")</td>
                                            <td>@(slip.TotalDeductions?.ToString("N0") ?? "-")</td>
                                            <td>@(slip.WithholdingTax?.ToString("N0") ?? "-")</td>
                                            <td><span class="pr-badge @(slip.ImportStatus == PayrollImportStatus.Parsed ? "pr-badge--ok" : "pr-badge--err")">@slip.ImportStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pr-empty">源泉徴収票データがありません。</div>
                }
            </div>

        </div>
    }
    else
    {
        <div class="pr-empty">
            まだデータがありません。<a href="/Import">Import</a> から PDF をアップロードしてください。
        </div>
    }

</div>

@if (Model.PayrollSlips.Count > 0 || Model.AnnualIncomeSlips.Count > 0)
{
    string AnnualLabels() =>
        string.Join(",", Model.AnnualIncomeSlips.Select(s => $"\"{s.FiscalYear}年\""));
    string AnnualData(Func<AnnualIncomeSlip, decimal?> sel) =>
        string.Join(",", Model.AnnualIncomeSlips.Select(s => sel(s) is { } v ? v.ToString() : "null"));

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // ── テーマカラー ──
        const CHART_COLORS = {
            light: { gross:'#16161a', net:'#0f766e', deduct:'#e11d48', basic:'#d97706', ot:'#9a9aa0', grid:'rgba(0,0,0,.06)', tick:'#9a9aa0' },
            dark:  { gross:'#2dd4bf', net:'#a78bfa', deduct:'#f472b6', basic:'#fbbf24', ot:'#566079', grid:'rgba(255,255,255,.06)', tick:'#6b7488' }
        };
        function themeKey() { return document.documentElement.classList.contains('dark') ? 'dark' : 'light'; }
        function C(k) { return CHART_COLORS[themeKey()][k]; }

        // ── Chart builders ──
        function makeSalaryChart(id, labels, gross, basic, deduct, net, overtime) {
            return new Chart(document.getElementById(id), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        { label:'総支給額', data:gross,    yAxisID:'y',  borderColor:C('gross'),  tension:0.3, fill:false, borderWidth:2 },
                        { label:'基本給',   data:basic,    yAxisID:'y',  borderColor:C('basic'),  tension:0.3, fill:false, borderWidth:2 },
                        { label:'控除合計', data:deduct,   yAxisID:'y',  borderColor:C('deduct'), tension:0.3, fill:false, borderWidth:2 },
                        { label:'手取り額', data:net,      yAxisID:'y',  borderColor:C('net'),    tension:0.3, fill:false, borderWidth:2 },
                        { label:'残業時間', data:overtime, yAxisID:'y2', borderColor:C('ot'),     tension:0.3, fill:false, borderWidth:1.5, borderDash:[5,5] },
                    ]
                },
                options: {
                    responsive:true,
                    plugins:{ legend:{ display:false } },
                    scales:{
                        y:{  position:'left',  ticks:{ color:C('tick'), callback:v=>v.toLocaleString()+'円' }, grid:{ color:C('grid') } },
                        y2:{ position:'right', ticks:{ color:C('tick'), callback:v=>v+'h' }, grid:{ drawOnChartArea:false } }
                    }
                }
            });
        }

        function makeChart(id, labels, gross, basic, deduct, net) {
            return new Chart(document.getElementById(id), {
                type:'line',
                data:{
                    labels,
                    datasets:[
                        { label:'総支給額', data:gross,  borderColor:C('gross'),  tension:0.3, fill:false, borderWidth:2 },
                        { label:'基本給',   data:basic,  borderColor:C('basic'),  tension:0.3, fill:false, borderWidth:2 },
                        { label:'控除合計', data:deduct, borderColor:C('deduct'), tension:0.3, fill:false, borderWidth:2 },
                        { label:'手取り額', data:net,    borderColor:C('net'),    tension:0.3, fill:false, borderWidth:2 },
                    ]
                },
                options:{
                    responsive:true,
                    plugins:{ legend:{ display:false } },
                    scales:{ y:{ ticks:{ color:C('tick'), callback:v=>v.toLocaleString()+'円' }, grid:{ color:C('grid') } } }
                }
            });
        }

        function toggle(chart, index, btn) {
            const meta = chart.getDatasetMeta(index);
            meta.hidden = !meta.hidden;
            btn.classList.toggle('active');
            chart.update();
        }

        function applyChartTheme(chart, isMultiAxis) {
            const tk = themeKey();
            const cc = CHART_COLORS[tk];
            const keys = ['gross','basic','deduct','net'];
            chart.data.datasets.forEach((ds, i) => {
                if (i < keys.length) ds.borderColor = cc[keys[i]];
                else ds.borderColor = cc.ot;
            });
            chart.options.scales.y.ticks.color = cc.tick;
            chart.options.scales.y.grid.color  = cc.grid;
            if (chart.options.scales.y2) chart.options.scales.y2.ticks.color = cc.tick;
            chart.update();
        }

        @if (Model.SalarySlips.Count > 0)
        {
            var salaryJson = System.Text.Json.JsonSerializer.Serialize(Model.SalarySlips.Select(s => new {
                month    = s.PayrollMonth,
                year     = s.PayrollMonth[..4],
                gross    = s.GrossAmount,
                basic    = s.BasicAmount,
                deduct   = s.DeductionAmount,
                net      = s.NetAmount,
                overtime = s.OvertimeHours,
            }));
            <text>
        const allSalarySlips = @Html.Raw(salaryJson);

        const salaryChart = makeSalaryChart('salaryChart',
            allSalarySlips.map(s => s.month),
            allSalarySlips.map(s => s.gross),
            allSalarySlips.map(s => s.basic),
            allSalarySlips.map(s => s.deduct),
            allSalarySlips.map(s => s.net),
            allSalarySlips.map(s => s.overtime)
        );

        function updateSalaryAverage(slips) {
            const avg = key => {
                const vals = slips.map(s => s[key]).filter(v => v != null);
                return vals.length > 0 ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
            };
            const rate   = (a, b) => (a != null && b != null && b > 0) ? a / b * 100 : null;
            const fmtInt = v => v != null ? Math.round(v).toLocaleString('ja-JP') : '-';
            const fmtDec = v => v != null ? v.toFixed(2) : '-';
            const fmtPct = v => v != null ? v.toFixed(1) + '%' : '-';
            const avgGross  = avg('gross');
            const avgDeduct = avg('deduct');
            const avgNet    = avg('net');
            document.getElementById('salary-avg-label').textContent       = `平均（${slips.length} 件）`;
            document.getElementById('salary-avg-gross').textContent       = fmtInt(avgGross);
            document.getElementById('salary-avg-basic').textContent       = fmtInt(avg('basic'));
            document.getElementById('salary-avg-overtime').textContent    = fmtDec(avg('overtime'));
            document.getElementById('salary-avg-deduct').textContent      = fmtInt(avgDeduct);
            document.getElementById('salary-avg-deduct-rate').textContent = fmtPct(rate(avgDeduct, avgGross));
            document.getElementById('salary-avg-net').textContent         = fmtInt(avgNet);
            document.getElementById('salary-avg-net-rate').textContent    = fmtPct(rate(avgNet, avgGross));
        }

        function filterSalary(year) {
            const f = year === 'all' ? allSalarySlips : allSalarySlips.filter(s => s.year === year);
            salaryChart.data.labels = f.map(s => s.month);
            const keys = ['gross','basic','deduct','net','overtime'];
            keys.forEach((k, i) => salaryChart.data.datasets[i].data = f.map(s => s[k]));
            salaryChart.update();
            document.querySelectorAll('#salary-table tr[data-year]').forEach(row => {
                row.style.display = (year === 'all' || row.dataset.year === year) ? '' : 'none';
            });
            document.querySelectorAll('.salary-year-btn').forEach(btn =>
                btn.classList.toggle('active', btn.dataset.year === year));
            updateSalaryAverage(f);
        }

        updateSalaryAverage(allSalarySlips);
            </text>
        }
        @if (Model.BonusSlips.Count > 0)
        {
            var bonusJson = System.Text.Json.JsonSerializer.Serialize(Model.BonusSlips.Select(s => new {
                month  = s.PayrollMonth,
                year   = s.PayrollMonth[..4],
                gross  = s.GrossAmount,
                deduct = s.DeductionAmount,
                net    = s.NetAmount,
            }));
            <text>
        const allBonusSlips = @Html.Raw(bonusJson);

        const bonusChart = makeChart('bonusChart',
            allBonusSlips.map(s => s.month),
            allBonusSlips.map(s => s.gross),
            [],
            allBonusSlips.map(s => s.deduct),
            allBonusSlips.map(s => s.net)
        );

        function filterBonus(year) {
            const f = year === 'all' ? allBonusSlips : allBonusSlips.filter(s => s.year === year);
            bonusChart.data.labels = f.map(s => s.month);
            bonusChart.data.datasets[0].data = f.map(s => s.gross);
            bonusChart.data.datasets[2].data = f.map(s => s.deduct);
            bonusChart.data.datasets[3].data = f.map(s => s.net);
            bonusChart.update();
            document.querySelectorAll('#bonus-table tr[data-year]').forEach(row => {
                row.style.display = (year === 'all' || row.dataset.year === year) ? '' : 'none';
            });
            document.querySelectorAll('.bonus-year-btn').forEach(btn =>
                btn.classList.toggle('active', btn.dataset.year === year));
        }
            </text>
        }
        @if (Model.AnnualIncomeSlips.Count > 0)
        {
            <text>
        const annualChart = makeChart('annualChart',
            [@Html.Raw(AnnualLabels())],
            [@Html.Raw(AnnualData(s => s.TotalIncome))],
            [@Html.Raw(AnnualData(s => s.AfterDeduction))],
            [@Html.Raw(AnnualData(s => s.TotalDeductions))],
            [@Html.Raw(AnnualData(s => s.WithholdingTax))]
        );
            </text>
        }

        // ── カスタムタブ切替（Bootstrap.Tab に依存しない） ──
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content .tab-pane').forEach(p => p.classList.remove('show','active'));
            const target = document.getElementById(tabId);
            if (target) { target.classList.add('active'); requestAnimationFrame(() => target.classList.add('show')); }
            if (btn) {
                document.querySelectorAll('#mainTabs .pr-tab').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
        }

        // ── テーマトグル ──
        function applyTheme(dark) {
            document.documentElement.classList.toggle('dark', dark);
            document.getElementById('seg-light').classList.toggle('pr-seg--on', !dark);
            document.getElementById('seg-dark').classList.toggle('pr-seg--on', dark);
            @if (Model.SalarySlips.Count > 0) { <text>applyChartTheme(salaryChart, true);</text> }
            @if (Model.BonusSlips.Count > 0)  { <text>applyChartTheme(bonusChart, false);</text> }
            @if (Model.AnnualIncomeSlips.Count > 0) { <text>applyChartTheme(annualChart, false);</text> }
        }

        function toggleTheme() {
            const isDark = !document.documentElement.classList.contains('dark');
            localStorage.setItem('pr-theme', isDark ? 'dark' : 'light');
            applyTheme(isDark);
        }

        // ── 起動時: localStorage からテーマ復元 ──
        (function() {
            const saved = localStorage.getItem('pr-theme');
            if (saved === 'dark') applyTheme(true);
        })();

        // ── 年フィルタを保持したまま詳細ページへ遷移 ──
        function goToSlip(id, type) {
            const btn = document.querySelector(`.${type}-year-btn.active`);
            const year = btn ? btn.dataset.year : 'all';
            location.href = `/slip/${id}?tab=${type}&year=${year}`;
        }

        // ── 詳細ページから戻ったときにタブ・年フィルタを復元 ──
        (function restoreFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const tab  = params.get('tab');
            const year = params.get('year') || 'all';
            if (!tab) return;

            if (tab === 'bonus') {
                switchTab('bonus-tab', document.querySelector('#mainTabs .pr-tab:nth-child(2)'));
                @if (Model.BonusSlips.Count > 0) { <text>filterBonus(year);</text> }
            } else if (tab === 'salary') {
                @if (Model.SalarySlips.Count > 0) { <text>filterSalary(year);</text> }
            }
            history.replaceState(null, '', location.pathname);
        })();
    </script>
}
